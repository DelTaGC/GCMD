{
  "name": "gcmd",
  "private": true,
  "version": "0.2.0",
  "description": "GCMD - a lightweight single-document GitHub Flavored Markdown editor",
  "license": "GPL-3.0-or-later WITH AdditionRef-GCMD-elkjs-exception",
  "author": "Gaetan Cretton",
  "repository": "github:DelTaGC/GCMD",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint . && prettier --check . && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:ts": "eslint .",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "typecheck": "tsc --noEmit",
    "spec:extract": "node tools/extract-gfm-spec.mjs",
    "fixtures:large": "node tools/gen-large-doc.mjs",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "linux:image": "docker build -t gcmd-linux-build tools/linux",
    "linux:check": "bash tools/linux/run.sh check",
    "linux:build": "bash tools/linux/run.sh build",
    "release:version": "node tools/release/version.mjs",
    "release:manifest": "node tools/release/manifest.mjs",
    "licenses": "node tools/release/licenses.mjs",
    "release:build": "tauri build --config src-tauri/tauri.release.conf.json",
    "check": "node tools/release/version.mjs && node tools/release/licenses.mjs --check && npm run typecheck && npm run lint && npm test && npm run test:rust",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ],
    "src-tauri/**/*.rs": [
      "rustfmt --edition 2024"
    ]
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  }
}
